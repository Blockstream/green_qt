option(ENABLE_SENTRY "Enable crash reports with sentry" OFF)

if(ENABLE_SENTRY AND (NOT SENTRY_KEY OR NOT SENTRY_PROJECT))
    message(FATAL_ERROR "ENABLE_SENTRY is ON but SENTRY_KEY/SENTRY_PROJECT is missing or empty")
endif()

message(STATUS "PROJECT_NAME = ${PROJECT_NAME}")
message(STATUS "PROJECT_VERSION = ${PROJECT_VERSION}")
message(STATUS "CMAKE_BUILD_TYPE = ${CMAKE_BUILD_TYPE}")
message(STATUS "GREEN_ENV = ${GREEN_ENV}")
message(STATUS "GREEN_BUILD_ID = ${GREEN_BUILD_ID}")
message(STATUS "GREEN_LOG_FILE = ${GREEN_LOG_FILE}")

if(NOT GREEN_ENV)
    set(CMAKE_BUILD_TYPE Debug)
    set(GREEN_ENV Development)
    set(GREEN_BUILD_ID -dev)
    set(GREEN_LOG_FILE dev)
endif()

if(NOT GREENLIGHT_DEVELOPER_CERT OR NOT GREENLIGHT_DEVELOPER_KEY)
    if(GREEN_ENV STREQUAL "Production")
        message(FATAL_ERROR "GREENLIGHT_DEVELOPER_CERT/GREENLIGHT_DEVELOPER_KEY is missing or empty")
    else()
        message(WARNING "GREENLIGHT_DEVELOPER_CERT/GREENLIGHT_DEVELOPER_KEY is missing or empty; Lightning will be unavailable")
    endif()
endif()

if(GREEN_ENV STREQUAL "Production")
    if(NOT COUNTLY_APP_KEY_PROD)
        message(FATAL_ERROR "COUNTLY_APP_KEY_PROD is missing or empty")
    endif()
    set(COUNTLY_APP_KEY "${COUNTLY_APP_KEY_PROD}")
else()
    set(COUNTLY_APP_KEY "${COUNTLY_APP_KEY_DEV}")
endif()

configure_file("${CMAKE_SOURCE_DIR}/installer.iss.in" "${CMAKE_BINARY_DIR}/installer.iss" @ONLY)
