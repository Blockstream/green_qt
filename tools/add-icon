#!/usr/bin/env bash
set -euo pipefail
# Keep generated registrations in the same filename order on every machine.
export LC_ALL=C

root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
assets="$root/qml/theme/icons"
work=$(mktemp -d)
trap 'rm -rf "$work"' EXIT

fail() {
    echo "$1" >&2
    exit 1
}

read_svg() {
    local name=$1
    [[ ! -e "$assets/$name.svg" ]] || fail "Icon already exists: $name"

    # Preserve the supplied text exactly; SVG validation and editing are manual.
    if [[ $# == 2 ]]; then
        printf '%s' "$2" > "$work/icon.svg"
    else
        command -v pbpaste >/dev/null || fail 'Clipboard import requires macOS pbpaste; pass SVG markup instead.'
        pbpaste > "$work/icon.svg"
    fi
    [[ -s "$work/icon.svg" ]] || fail 'SVG input is empty.'
}

collect_names() {
    local new_name=$1
    local file
    {
        for file in "$assets"/*.svg; do
            if [[ -f "$file" ]]; then
                basename "$file" .svg
            fi
        done
        # Include the pending SVG before writing it into the asset folder.
        if [[ -n "$new_name" ]]; then
            printf '%s\n' "$new_name"
        fi
    } | sort > "$work/names"
}

generate_qml() {
    # Typed properties give editors completion without a separate icon catalog.
    awk -F- '
        function fail(message) {
            print message > "/dev/stderr"
            exit 1
        }
        function is_reserved(key) {
            # QML also reserves identifiers beyond JavaScript keywords.
            return key ~ /^(break|case|catch|class|const|continue|debugger|default|delete|do|else|enum|export|extends|false|finally|for|function|if|import|in|instanceof|let|new|null|return|super|switch|this|throw|true|try|typeof|var|void|while|with|yield)$/ \
                || key ~ /^(abstract|as|implements|interface|native|package|pragma|private|protected|public|static|synchronized|throws|transient|volatile)$/
        }
        # Convert kebab-case filenames to camelCase property names.
        function property_name(    key, i) {
            key = $1
            for (i=2; i<=NF; i++) {
                key = key toupper(substr($i,1,1)) substr($i,2)
            }
            # Keep the SVG filename, but make the QML name legal (package -> packageIcon).
            if (is_reserved(key)) {
                key = key "Icon"
            }
            return key
        }
        {
            if ($0 !~ /^[a-z][a-z0-9]*(-[a-z0-9]+)*$/ || $0 == "none") {
                fail("Invalid icon filename: " $0)
            }
            key = property_name()
            if (key == "objectName") fail("Reserved icon property: " key)
            if (seen[key]++) fail("Duplicate icon property: " key)
            printf "    readonly property string %s: \"%s\"\n", key, $0
        }
    ' "$work/names" > "$work/entries"

    {
        printf '// Generated by tools/add-icon. Do not edit.\nimport QtQml\n\nQtObject {\n'
        cat "$work/entries"
        printf '}\n'
    } > "$work/Icons.qml"
}

generate_cmake() {
    {
        cat <<'CMAKE'
# Generated by tools/add-icon. Do not edit.
qt_add_resources(blockstream_theme "ui_icons"
    PREFIX "/ui-icons"
    BASE "${CMAKE_CURRENT_SOURCE_DIR}"
    FILES
CMAKE
        sed 's|^|        |; s|$|.svg|' "$work/names"
        printf ')\n'
    } > "$work/CMakeLists.txt"
}

save_outputs() {
    local new_name=$1
    if [[ -n "$new_name" ]]; then
        mv "$work/icon.svg" "$assets/$new_name.svg"
    fi
    mv "$work/Icons.qml" "$root/qml/theme/Icons.qml"
    mv "$work/CMakeLists.txt" "$assets/CMakeLists.txt"
}

main() {
    local new_name=''
    if [[ $# -ne 1 || $1 != --generate ]]; then
        if [[ $# -lt 1 || $# -gt 2 || ! $1 =~ ^[a-z][a-z0-9]*(-[a-z0-9]+)*$ || $1 == none ]]; then
            fail "Usage: $0 <lowercase-kebab-name> ['<svg>...</svg>'] | --generate"
        fi
        new_name=$1
        read_svg "$@"
    fi

    # Generate both registrations before replacing any project files.
    collect_names "$new_name"
    generate_qml
    generate_cmake
    save_outputs "$new_name"
    echo 'Updated icon registrations from SVG filenames. Commit the changed files.'
}

main "$@"
