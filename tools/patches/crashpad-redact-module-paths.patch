                                 size_t destination_size,
                                 const std::string& source);
+
+  //! \brief Replaces the user component of a home directory path with a
+  //!     placeholder, so that an uploaded minidump does not identify the local
+  //!     account.
+  //!
+  //! The component following a path component named `Users` or `home`, matched
+  //! without regard to case, is replaced with `<user>`. Both `/` and `\` are
+  //! treated as separators, so a single implementation covers every platform.
+  //!
+  //! \param[in] path The path to redact.
+  //!
+  //! \return \a path with the user component replaced, or \a path unchanged if
+  //!     it does not lie under a home directory.
+  static std::string RedactUserFromPath(const std::string& path);
 };
 
 }  // namespace internal
