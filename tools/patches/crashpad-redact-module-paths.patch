+// static
+std::string MinidumpWriterUtil::RedactUserFromPath(const std::string& path) {
+  static constexpr char kPlaceholder[] = "<user>";
+
+  size_t component_start = 0;
+  bool after_home_root = false;
+
+  for (size_t i = 0; i <= path.size(); ++i) {
+    if (i != path.size() && path[i] != '/' && path[i] != '\\') {
+      continue;
+    }
+
+    // Skip empty components, so that doubled separators do not lose track of
+    // the home root.
+    if (i > component_start) {
+      if (after_home_root) {
+        return path.substr(0, component_start) + kPlaceholder + path.substr(i);
+      }
+
+      std::string component = path.substr(component_start, i - component_start);
+      for (size_t j = 0; j < component.size(); ++j) {
+        if (component[j] >= 'A' && component[j] <= 'Z') {
+          component[j] = static_cast<char>(component[j] - 'A' + 'a');
+        }
+      }
+      after_home_root = component == "users" || component == "home";
+    }
+
+    component_start = i + 1;
+  }
+
+  return path;
+}
+
 }  // namespace internal
 }  // namespace crashpad
diff --git a/minidump/minidump_writer_util.h b/minidump/minidump_writer_util.h
