@@ -88,13 +84,14 @@ void MinidumpExceptionWriter::SetExceptionInformation(

 bool MinidumpExceptionWriter::Freeze() {
   DCHECK_EQ(state(), kStateMutable);
-  CHECK(context_);

   if (!MinidumpStreamWriter::Freeze()) {
