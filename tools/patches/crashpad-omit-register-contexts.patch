   SetExceptionInformation(exception_snapshot->Codes());
-
-  std::unique_ptr<MinidumpContextWriter> context =
-      MinidumpContextWriter::CreateFromSnapshot(exception_snapshot->Context());
-  SetContext(std::move(context));
 }

