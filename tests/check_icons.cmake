get_filename_component(ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(GLOB_RECURSE SVG_FILES RELATIVE "${ROOT}/qml/theme/icons" "${ROOT}/qml/theme/icons/*.svg")
file(READ "${ROOT}/qml/theme/Icons.qml" ICONS_QML)
string(REGEX MATCHALL "readonly property string [A-Za-z0-9_]+: \"[^\"]+\"" ENTRIES "${ICONS_QML}")
set(LISTED_FILES)
foreach(ENTRY IN LISTS ENTRIES)
    string(REGEX REPLACE "readonly property string [A-Za-z0-9_]+: \"([^\"]+)\"" "\\1.svg" FILE_NAME "${ENTRY}")
    list(APPEND LISTED_FILES "${FILE_NAME}")
endforeach()
list(SORT SVG_FILES)

function(check_icon_files LABEL)
    set(FILES ${ARGN})
    list(SORT FILES)
    if(NOT "${SVG_FILES}" STREQUAL "${FILES}")
        set(UNLISTED "${SVG_FILES}")
        set(MISSING "${FILES}")
        if(FILES)
            list(REMOVE_ITEM UNLISTED ${FILES})
        endif()
        if(SVG_FILES)
            list(REMOVE_ITEM MISSING ${SVG_FILES})
        endif()
        message(FATAL_ERROR "${LABEL} mismatch. Unlisted SVGs: [${UNLISTED}]. Missing SVGs: [${MISSING}]. Check duplicate entries too.")
    endif()
endfunction()

check_icon_files("Icons.qml" ${LISTED_FILES})
file(READ "${ROOT}/qml/theme/icons/CMakeLists.txt" RESOURCE_CMAKE)
string(REGEX MATCHALL "[a-z][a-z0-9-]*\\.svg" RESOURCE_FILES "${RESOURCE_CMAKE}")
check_icon_files("qml/theme/icons/CMakeLists.txt" ${RESOURCE_FILES})
message(STATUS "Icons.qml and qml/theme/icons/CMakeLists.txt match all SVG files")
